generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  nome      String
  plano     String   @default("basic")
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  clientes      Cliente[]
  veiculos      Veiculo[]
  pecas         Peca[]
  ordensServico OrdemServico[]
  itensOS       ItemOrdemServico[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  nome      String
  email     String
  senhaHash String   @map("senha_hash")
  role      String   @default("mecanico")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model Cliente {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  nome      String
  telefone  String
  email     String?
  senhaHash String?  @map("senha_hash")
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  veiculos      Veiculo[]
  ordensServico OrdemServico[]

  @@unique([tenantId, email])
  @@map("clientes")
}

model Veiculo {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  clienteId String   @map("cliente_id")
  placa     String
  modelo    String
  ano       Int
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordensServico OrdemServico[]

  @@unique([tenantId, placa])
  @@map("veiculos")
}

model Peca {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  nome              String
  descricao         String?
  quantidadeEstoque Int      @default(0) @map("quantidade_estoque")
  precoCusto        Decimal? @map("preco_custo") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itensOS ItemOrdemServico[]

  @@map("pecas")
}

model OrdemServico {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  clienteId        String    @map("cliente_id")
  veiculoId        String    @map("veiculo_id")
  status           String    @default("aberta")
  descricaoServico String    @map("descricao_servico")
  dataAbertura     DateTime  @default(now()) @map("data_abertura")
  dataFechamento   DateTime? @map("data_fechamento")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo Veiculo            @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  itens   ItemOrdemServico[]

  @@map("ordens_servico")
}

model ItemOrdemServico {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  osId       String @map("os_id")
  pecaId     String @map("peca_id")
  quantidade Int

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  peca         Peca         @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@map("itens_ordem_servico")
}
